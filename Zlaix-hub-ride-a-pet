local function saveConfig()
    local success, err = pcall(function()
        if writefile then
            local saveData = {}
            for k, v in pairs(Config) do
                if typeof(v) ~= "Color3" then
                    saveData[k] = v
                end
            end
            writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(saveData))
            lastConfigActionStatus = "Config Tersimpan (" .. os.date("%H:%M:%S") .. ")"
        end
    end)
    return success
end

local function loadConfig()
    local success, err = pcall(function()
        if readfile and isfile and isfile(CONFIG_FILE_NAME) then
            local raw = readfile(CONFIG_FILE_NAME)
            local data = HttpService:JSONDecode(raw)
            if data and type(data) == "table" then
                for k, v in pairs(data) do
                    if DefaultConfig[k] ~= nil then
                        Config[k] = v
                    end
                end
                lastConfigActionStatus = "Config Dimuat (" .. os.date("%H:%M:%S") .. ")"
            end
        end
    end)
    return success
end

local function resetConfigToDefault()
    for k, v in pairs(DefaultConfig) do
        Config[k] = v
    end
    saveConfig()
    lastConfigActionStatus = "Config Reset Default (" .. os.date("%H:%M:%S") .. ")"
end

