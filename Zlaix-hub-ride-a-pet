local function detectExecutorName()
    local name = nil
    
    pcall(function()
        if identifyexecutor then
            local execName, execVer = identifyexecutor()
            if execName and tostring(execName) ~= "" then
                name = tostring(execName)
            end
        end
    end)
    
    if name then return name end
    
    pcall(function()
        if getexecutorname then
            local execName = getexecutorname()
            if execName and tostring(execName) ~= "" then
                name = tostring(execName)
            end
        end
    end)

    if name then return name end

    local g = (getgenv and getgenv()) or _G or {}
    
    if syn and syn.toast_notification then return "Synapse Z"
    elseif syn then return "Synapse"
    elseif DELTA_LOADED or g.DELTA_LOADED or g.Delta then return "Delta"
    elseif SOLARA_LOADED or g.SOLARA_LOADED or g.Solara then return "Solara"
    elseif WAVE_LOADED or g.WAVE_LOADED or g.Wave then return "Wave"
    elseif XENO_LOADED or g.XENO_LOADED or g.Xeno then return "Xeno"
    elseif FLUXUS_LOADED or g.FLUXUS_LOADED or g.Fluxus then return "Fluxus"
    elseif HYDROGEN_LOADED or g.HYDROGEN_LOADED or g.Hydrogen then return "Hydrogen"
    elseif CODEX_LOADED or g.CODEX_LOADED or g.Codex then return "Codex"
    elseif KRNL_LOADED or g.KRNL_LOADED then return "Krnl"
    elseif OXYGEN_LOADED or g.OXYGEN_LOADED then return "Oxygen U"
    elseif SWIFT_LOADED or g.SWIFT_LOADED then return "Swift"
    elseif VALYSE_LOADED or g.VALYSE_LOADED then return "Valyse"
    elseif ARCEUS_LOADED or g.ARCEUS_LOADED then return "Arceus X"
    end

    return "Unknown"
end

