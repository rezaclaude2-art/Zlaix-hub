local function getMyPlot()
    if Workspace:FindFirstChild("Plots") then
        local myId = tostring(LocalPlayer.UserId)
        local myName = LocalPlayer.Name

        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            for _, attrName in ipairs({"NestsOwnerLoaded", "OwnerUserId", "Owner", "UserId"}) do
                local attr = plot:GetAttribute(attrName)
                if attr and (tostring(attr) == myId or attr == LocalPlayer.UserId) then
                    return plot
                end
            end
        end

        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            local petsFolder = plot:FindFirstChild("Pets")
            if petsFolder then
                for _, pet in ipairs(petsFolder:GetChildren()) do
                    local petOwner = pet:GetAttribute("OwnerUserId") or pet:GetAttribute("Owner")
                    if petOwner and (tostring(petOwner) == myId or petOwner == LocalPlayer.UserId) then
                        return plot
                    end
                end
            end
        end

        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            local eggsFolder = plot:FindFirstChild("Eggs")
            if eggsFolder then
                for _, egg in ipairs(eggsFolder:GetChildren()) do
                    local eggOwner = egg:GetAttribute("OwnerUserId") or egg:GetAttribute("Owner")
                    if eggOwner and (tostring(eggOwner) == myId or eggOwner == LocalPlayer.UserId) then
                        return plot
                    end
                end
            end
        end

        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            local board = plot:FindFirstChild("Board") or plot:FindFirstChild("PlotSign") or plot:FindFirstChild("Sign") or plot:FindFirstChild("HatchUpgrade")
            if board then
                for _, desc in ipairs(board:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text ~= "" then
                        if desc.Text:find("Peternakan Anda") or desc.Text:find(myName) or desc.Text:find(myId) then
                            return plot
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function getElevatedInsideBaseCFrame()
    local myPlot = getMyPlot()
    if myPlot then
        local pcf, _ = myPlot:GetBoundingBox()
        return CFrame.new(pcf.Position + Vector3.new(0, 40, 0))
    end
    local spawn = Workspace:FindFirstChild("SpawnLocation") or Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if spawn then
        return spawn.CFrame * CFrame.new(0, 40, 0)
    end
    return CFrame.new(0, 40, 0)
end

local function getBackOfBaseCFrame()
    local myPlot = getMyPlot()
    if myPlot then
        local pcf, size = myPlot:GetBoundingBox()
        -- Posisi X dan Z sejauh 7 stud di belakang plot.
        local backCF = pcf * CFrame.new(0, 0, -(size.Z / 2 + 7))
        -- Teleport 10 stud di udara agar karakter jatuh perlahan & stabil tanpa clipping ke bawah map
        return CFrame.new(backCF.Position.X, pcf.Position.Y + 10, backCF.Position.Z)
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        return hrp.CFrame
    end
    return CFrame.new(0, 50, 0)
end

