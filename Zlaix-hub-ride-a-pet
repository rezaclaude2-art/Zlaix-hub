local processedEggsCache = {}
local failedEggsCache = {}
local attemptedEggsCount = {}

local function isBlacklistedEgg(eggModel)
    if not eggModel or not eggModel.Parent then return true end

    -- 1. Ignore plot eggs
    if eggModel:FindFirstAncestor("Plots") then
        return true
    end

    local lowerName = eggModel.Name:lower()

    -- 2. Ignore static map environment parts, triggers, waypoints, or shops
    if lowerName:find("entrance") or lowerName:find("validate") or lowerName:find("dip") or lowerName:find("waypoint") or lowerName:find("spawn") or lowerName:find("gate") or lowerName:find("asteroid") or lowerName:find("adminegg") or lowerName:find("admin") or lowerName:find("heldegg") or lowerName:find("display") or lowerName:find("pedestal") or lowerName:find("shop") or lowerName:find("plot") or lowerName:find("board") then
        return true
    end

    -- 3. Check if model is blacklisted (120s)
    if failedEggsCache[eggModel] and (tick() - failedEggsCache[eggModel] < 120) then
        return true
    end

    -- 4. Special check for Volcanic Egg: Must be a real spawned Volcanic Egg model
    if lowerName:find("volcanic") then
        return false
    end

    -- 5. Real wild eggs must have an active ProximityPrompt
    local prompt = eggModel:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        return true
    end

    return false
end

local function getEggInfo(eggModel)
    if not eggModel or not eggModel.Parent then return nil end
    if not eggModel:IsA("PVInstance") then return nil end
    if eggModel.Name:find("EggTracker") then return nil end

    if isBlacklistedEgg(eggModel) then
        return nil
    end

    local rarity = getEggRarity(eggModel.Name, eggModel)
    if not rarity then return nil end

    local cf = eggModel:GetPivot()
    local isPlot = eggModel:FindFirstAncestor("Plots") ~= nil
    
    return {
        Model = eggModel,
        Part = eggModel:IsA("Model") and (eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart", true)) or eggModel,
        Position = cf.Position,
        CFrame = cf,
        Name = eggModel.Name,
        Rarity = rarity,
        IsPlot = isPlot
    }
end

local function getRarityColor(rarity)
    if rarity == "Volcanic" then return Config.VolcanoColor end
    if rarity == "Ethereal" then return Config.EtherealColor end
    if rarity == "Divine" then return Config.DivineColor end
    if rarity == "Mythic" then return Config.MythicColor end
    if rarity == "Legendary" then return Config.LegendaryColor end
    if rarity == "Epic" then return Config.EpicColor end
    if rarity == "Rare" then return Config.RareColor end
    return Config.CommonColor
end

local function isRarityEnabled(rarity)
    if rarity == "Volcanic" then return Config.AutoCatchVolcanicEgg end
    if rarity == "Ethereal" then return Config.ShowEthereal end
    if rarity == "Divine" then return Config.ShowDivine end
    if rarity == "Mythic" then return Config.ShowMythic end
    if rarity == "Legendary" then return Config.ShowLegendary end
    if rarity == "Epic" then return Config.ShowEpic end
    if rarity == "Rare" then return Config.ShowRare end
    return Config.ShowCommon
end

local scanCacheList = nil
local scanCacheTime = 0

local function scanEggs()
    local nowT = tick()
    if scanCacheList and (nowT - scanCacheTime) < 0.3 then
        return scanCacheList
    end

    local list = {}
    local seen = {}

    local function checkAndAdd(obj)
        if not obj or seen[obj] then return end
        seen[obj] = true
        local info = getEggInfo(obj)
        if info then table.insert(list, info) end
    end

    -- 1. Scan RenderedEggs container (where wild spawned eggs live!)
    local container = Workspace:FindFirstChild("RenderedEggs")
    if container then
        for _, egg in pairs(container:GetChildren()) do
            checkAndAdd(egg)
        end
    end

    -- 2. Scan top-level Workspace for wild spawned egg models
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:find("Egg") and obj ~= Workspace:FindFirstChild("Plots") and obj ~= Workspace:FindFirstChild("RenderedEggs") and not obj:IsA("Folder") and not obj:IsA("Terrain") then
            checkAndAdd(obj)
        end
    end

    scanCacheList = list
    scanCacheTime = nowT
    return list
end

local function isFarmRarityEnabled(rarity)
    if rarity == "Volcanic" then return Config.AutoCatchVolcanicEgg end
    if rarity == "Ethereal" then return Config.FarmEthereal end
    if rarity == "Divine" then return Config.FarmDivine end
    if rarity == "Mythic" then return Config.FarmMythic end
    if rarity == "Legendary" then return Config.FarmLegendary end
    if rarity == "Epic" then return Config.FarmEpic end
    if rarity == "Rare" then return Config.FarmRare end
    if rarity == "Common" then return Config.FarmCommon end
    return true
end

local function getHighestRarityEggTarget()
    local eggs = scanEggs()

    if Config.AutoCatchVolcanicEgg then
        for _, info in ipairs(eggs) do
            if not info.IsPlot and (info.Rarity == "Volcanic" or info.Name:lower():find("volcan")) then
                return info
            end
        end
    end

    local bestEgg = nil
    local highestPriority = 0

    for _, info in ipairs(eggs) do
        if not info.IsPlot then
            if isFarmRarityEnabled(info.Rarity) then
                local prio = RarityPriority[info.Rarity] or 0
                if prio > highestPriority then
                    highestPriority = prio
                    bestEgg = info
                end
            end
        end
    end
    return bestEgg
end

