local function triggerProximityOnEgg(eggModel)
    local targetObj = eggModel
    
    if not targetObj or not targetObj.Parent then
        -- Jika eggModel tidak ada, cari ProximityPrompt terdekat dari posisi karakter (misal telur yang baru didrop)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local closestPrompt = nil
            local minDist = 25
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Enabled then
                    local parentPart = desc.Parent
                    if parentPart and parentPart:IsA("BasePart") then
                        -- Validasi ketat: pastikan ini adalah ProximityPrompt milik EGG (Telur) agar tidak ngasal klik board/sign
                        local model = parentPart.Parent
                        if model and (model.Name:lower():find("egg") or (model.Parent and model.Parent.Name:lower():find("egg"))) then
                            local dist = (hrp.Position - parentPart.Position).Magnitude
                            if dist < minDist then
                                minDist = dist
                                closestPrompt = desc
                            end
                        end
                    end
                end
            end
            if closestPrompt then
                applyInstantPromptSettings(closestPrompt)
                for i = 1, 3 do
                    pcall(function()
                        if fireproximityprompt then
                            fireproximityprompt(closestPrompt)
                        else
                            closestPrompt:InputHoldBegin()
                            task.wait(0.02)
                            closestPrompt:InputHoldEnd()
                        end
                    end)
                    task.wait(0.05)
                end
                return true
            end
        end
        return false
    end

    local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        local startWait = tick()
        while not prompt and (tick() - startWait < 0.3) do
            task.wait(0.04)
            if targetObj and targetObj.Parent then
                prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
            end
        end
    end

    if prompt then
        applyInstantPromptSettings(prompt)

        -- Click E tepat 3x
        for i = 1, 3 do
            pcall(function()
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                else
                    prompt:InputHoldBegin()
                    task.wait(0.02)
                    prompt:InputHoldEnd()
                end
            end)
            task.wait(0.05)
        end

        pcall(function()
            local pickupRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Game") and ReplicatedStorage.Remotes.Game:FindFirstChild("EggPickup")
            if pickupRemote then
                pickupRemote:FireServer(targetObj)
            end
        end)
        return true
    end
    return false
end

