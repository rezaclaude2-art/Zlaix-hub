local function getEggRarity(eggName, eggModel)
    local lowerName = eggName:lower()
    if lowerName:find("volcan") then
        return "Volcanic"
    end

    if eggModel then
        local rAttr = pcall(function() return eggModel:GetAttribute("Rarity") end) and eggModel:GetAttribute("Rarity")
        if rAttr and rAttr ~= "" then return rAttr end
    end
    if EggData[eggName] and EggData[eggName].Rarity then
        return EggData[eggName].Rarity
    end

    if lowerName:find("ethereal") or lowerName:find("solaris") or lowerName:find("blackhole") or lowerName:find("black hole") or lowerName:find("black_hole") or lowerName:find("cherub") or lowerName:find("giant") or lowerName:find("dragon") then
        return "Ethereal"
    elseif lowerName:find("divine") or lowerName:find("aurora") or lowerName:find("galaxy") or lowerName:find("bloom") then
        return "Divine"
    elseif lowerName:find("mythic") or lowerName:find("diamond") or lowerName:find("crystal") or lowerName:find("skull") or lowerName:find("dominus") or lowerName:find("asteroid") or lowerName:find("flaming") or lowerName:find("sinister") or lowerName:find("soul") or lowerName:find("tidal") then
        return "Mythic"
    elseif lowerName:find("legendary") or lowerName:find("glass") or lowerName:find("golden") then
        return "Legendary"
    elseif lowerName:find("epic") or lowerName:find("mushroom") or lowerName:find("flower") or lowerName:find("slime") or lowerName:find("ice") then
        return "Epic"
    elseif lowerName:find("rare") or lowerName:find("cracked") or lowerName:find("stone") or lowerName:find("leaf") or lowerName:find("easter") then
        return "Rare"
    end
    return "Common"
end

