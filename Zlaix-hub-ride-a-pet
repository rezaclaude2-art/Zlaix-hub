            ValueBadge.Size = UDim2.new(0.3, 0, 0, 15)
            ValueBadge.Position = UDim2.new(0.7, 0, 0, 0)
            ValueBadge.BackgroundTransparency = 1
            ValueBadge.Text = tostring(defaultVal) .. (suffix or "")
            ValueBadge.TextColor3 = sTheme.PrimaryText
            ValueBadge.Font = Enum.Font.GothamBold
            ValueBadge.TextSize = 12
            ValueBadge.TextXAlignment = Enum.TextXAlignment.Right
            ValueBadge.Parent = SliderFrame

            local TrackFrame = Instance.new("TextButton")
            TrackFrame.Size = UDim2.new(1, 0, 0, 4)
            TrackFrame.Position = UDim2.new(0, 0, 0, 28)
            TrackFrame.BackgroundColor3 = sTheme.SwitchOffBG
            TrackFrame.BorderSizePixel = 0
            TrackFrame.Text = ""
            TrackFrame.Parent = SliderFrame

            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = TrackFrame

            local FillFrame = Instance.new("Frame")
            local initPercent = math.clamp((defaultVal - min) / (max - min), 0, 1)
            FillFrame.Size = UDim2.new(initPercent, 0, 1, 0)
            FillFrame.BackgroundColor3 = sTheme.SwitchOnBG
            FillFrame.BorderSizePixel = 0
            FillFrame.Parent = TrackFrame

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = FillFrame

            table.insert(registeredSliders, {
                Label = LabelText,
                Value = ValueBadge,
                Track = TrackFrame,
                Fill = FillFrame
            })

            local sliding = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - TrackFrame.AbsolutePosition.X) / TrackFrame.AbsoluteSize.X, 0, 1)
                local val = min + (max - min) * pos
                if max - min > 20 then
                    val = math.floor(val)
                else
                    val = math.floor(val * 100) / 100
                end
                ValueBadge.Text = tostring(val) .. (suffix or "")
                TweenService:Create(FillFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(pos, 0, 1, 0) }):Play()
                pcall(callback, val)
            end

            TrackFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    TweenService:Create(TrackFrame, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 27) }):Play()
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if sliding then
                        sliding = false
                        TweenService:Create(TrackFrame, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 28) }):Play()
                        saveConfig()
                    end
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
        end

        function CardObj.AddButton(name, callback)
            local bTheme = getActiveTheme()

            local Btn = Instance.new("TextButton")
            Btn.Name = "Button_" .. name
            Btn.Size = UDim2.new(1, 0, 0, 30)
            Btn.BackgroundColor3 = bTheme.ButtonBG
            Btn.BorderSizePixel = 0
            Btn.Text = name
            Btn.TextColor3 = bTheme.ButtonText
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = 12
            Btn.Parent = ContentContainer

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 10)
            BtnCorner.Parent = Btn

            local BtnStroke = Instance.new("UIStroke")
            BtnStroke.Color = bTheme.StrokeColor
            BtnStroke.Thickness = 1
            BtnStroke.Parent = Btn

            table.insert(registeredButtons, { Btn = Btn, Stroke = BtnStroke })

            Btn.MouseEnter:Connect(function()
                local cTheme = getActiveTheme()
                TweenService:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = cTheme.ButtonHover }):Play()
            end)
            Btn.MouseLeave:Connect(function()
                local cTheme = getActiveTheme()
                TweenService:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = cTheme.ButtonBG }):Play()
            end)
            Btn.MouseButton1Click:Connect(function()
                pcall(callback)
            end)
        end

        function CardObj.AddParagraph(text, isHeading)
            local pTheme = getActiveTheme()

            local P = Instance.new("TextLabel")
            P.Size = UDim2.new(1, 0, 0, 16)
            P.AutomaticSize = Enum.AutomaticSize.Y
            P.BackgroundTransparency = 1
            P.Text = text
            P.TextColor3 = isHeading and pTheme.PrimaryText or pTheme.SecondaryText
            P.Font = isHeading and Enum.Font.GothamBold or Enum.Font.Gotham
            P.TextSize = isHeading and 13 or 12
            P.TextXAlignment = Enum.TextXAlignment.Left
            P.TextYAlignment = Enum.TextYAlignment.Top
            P.TextWrapped = true
            P.Parent = ContentContainer

            if not isHeading then
                table.insert(registeredLabels, { Label = P })
            end
            return P
        end

        function CardObj.AddLabel(text)
            local lTheme = getActiveTheme()

            local LabelText = Instance.new("TextLabel")
            LabelText.Size = UDim2.new(1, 0, 0, 20)
            LabelText.BackgroundTransparency = 1
            LabelText.Text = text
            LabelText.TextColor3 = lTheme.SecondaryText
            LabelText.Font = Enum.Font.Gotham
            LabelText.TextSize = 12
            LabelText.TextXAlignment = Enum.TextXAlignment.Left
            LabelText.Parent = ContentContainer

            table.insert(registeredLabels, { Label = LabelText })

            return {
                Set = function(selfOrText, optionalText)
                    local newText = (type(selfOrText) == "table" and optionalText) or selfOrText
                    LabelText.Text = tostring(newText or "")
                end,
                SetText = function(newText)
                    LabelText.Text = tostring(newText or "")
                end,
                TextLabel = LabelText
            }
        end

        return CardObj
    end

    return TabObj
end

