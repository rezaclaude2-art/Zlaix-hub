local function applyThemeToAllElements()
    local theme = getActiveTheme()

    MainFrame.BackgroundColor3 = theme.MainBG
    MainStroke.Color = theme.StrokeColor
    Sidebar.BackgroundColor3 = theme.SidebarBG
    SidebarBorder.BackgroundColor3 = theme.SidebarBorder
    LogoIcon.BackgroundColor3 = theme.CardBG
    if LogoText then LogoText.TextColor3 = theme.PrimaryText end
    TitleLabel.TextColor3 = theme.PrimaryText
    SubtitleLabel.TextColor3 = theme.SecondaryText
    ActivePill.BackgroundColor3 = theme.AccentPill
    DiscordPill.BackgroundColor3 = theme.CardBG
    DiscordPill.TextColor3 = theme.SecondaryText
    TabTitleText.TextColor3 = theme.PrimaryText
    TabDescText.TextColor3 = theme.SecondaryText
    SearchFrame.BackgroundColor3 = theme.InputBG
    SearchStroke.Color = theme.InputStroke
    SearchBox.TextColor3 = theme.PrimaryText
    SearchBox.PlaceholderColor3 = theme.SecondaryText
    MinimizeBtn.BackgroundColor3 = theme.CardBG
    MinimizeBtn.TextColor3 = theme.SecondaryText
    CloseBtn.BackgroundColor3 = theme.CardBG
    CloseBtn.TextColor3 = theme.SecondaryText
    BottomBar.BackgroundColor3 = theme.FooterBG
    BottomBorder.BackgroundColor3 = theme.FooterBorder
    ExecutorBadge.TextColor3 = theme.SecondaryText
    FpsBadge.TextColor3 = theme.SecondaryText
    VersionBadge.TextColor3 = theme.SecondaryText
    ToggleWidget.BackgroundColor3 = theme.MainBG
    if ToggleWidget.Text ~= "" then ToggleWidget.TextColor3 = theme.PrimaryText end
    ToggleStroke.Color = theme.StrokeColor

    -- Cards
    for _, card in ipairs(registeredCards) do
        card.Frame.BackgroundColor3 = theme.CardBG
        card.Stroke.Color = theme.CardStroke
        card.Title.TextColor3 = theme.PrimaryText
    end

    -- Toggles
    for _, item in ipairs(registeredToggles) do
        item.Label.TextColor3 = theme.PrimaryText
        item.Desc.TextColor3 = theme.SecondaryText
        item.Switch.BackgroundColor3 = item.GetToggled() and theme.SwitchOnBG or theme.SwitchOffBG
        item.Knob.BackgroundColor3 = item.GetToggled() and theme.KnobOn or theme.KnobOff
    end

    -- Sliders
    for _, item in ipairs(registeredSliders) do
        item.Label.TextColor3 = theme.PrimaryText
        item.Value.TextColor3 = theme.PrimaryText
        item.Track.BackgroundColor3 = theme.SwitchOffBG
        item.Fill.BackgroundColor3 = theme.SwitchOnBG
    end

    -- Buttons
    for _, item in ipairs(registeredButtons) do
        item.Btn.BackgroundColor3 = theme.ButtonBG
        item.Btn.TextColor3 = theme.ButtonText
        item.Stroke.Color = theme.StrokeColor
    end

    -- Labels
    for _, item in ipairs(registeredLabels) do
        item.Label.TextColor3 = theme.SecondaryText
    end

    -- Nav Tab Buttons
    for _, item in ipairs(registeredNavButtons) do
        if item.IsSelected() then
            item.Btn.TextColor3 = theme.PrimaryText
            item.Btn.BackgroundColor3 = theme.NavActiveBG
            item.Btn.BackgroundTransparency = 0
        else
            item.Btn.TextColor3 = theme.SecondaryText
            item.Btn.BackgroundTransparency = 1
        end
    end
end

