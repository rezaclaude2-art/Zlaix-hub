    if not targetEgg or not targetEgg.Model or not targetEgg.Model.Parent then
        if not Config.AutoFarmEnabled and Config.AutoCatchVolcanicEgg then
            scriptStatusState.AutoFarmActivity = "Auto Catch Volcanic Egg: Menunggu Spawn"
        else
            scriptStatusState.AutoFarmActivity = "Idle / Menunggu Egg Spawn"
        end
        isAutoFarming = false
        return
    end

    -- If general Auto Farm is OFF, only process Volcanic Eggs
    if not Config.AutoFarmEnabled and (targetEgg.Rarity ~= "Volcanic" and not targetEgg.Name:lower():find("volcan")) then
        scriptStatusState.AutoFarmActivity = "Auto Catch Volcanic Egg: Menunggu Spawn"
        isAutoFarming = false
        return
    end

    -- Process target egg attempt safely without premature blacklisting
    processedEggsCache[targetEgg.Model] = tick()

    if Config.FlyEnabled then stopFly() end

    -- 1. ALUR VOLCANIC EGG
    if targetEgg.Rarity == "Volcanic" or targetEgg.Name:lower():find("volcan") then
        runVolcanicMazeSequence(targetEgg.Model)
        isAutoFarming = false
        return
    end

    -- 2. ALUR WILD EGG LAINNYA
    scriptStatusState.AutoFarmActivity = string.format("TP to Egg [%s] %s", targetEgg.Rarity, targetEgg.Name)

    -- Step A: TP ke posisi Egg & Click E 3x
    teleportPlayerToCFrame(targetEgg.CFrame * CFrame.new(0, 2.5, 0))
    task.wait(0.20)

    local trigOk = triggerProximityOnEgg(targetEgg.Model)
    task.wait(0.5)

    if targetEgg.Model and targetEgg.Model.Parent then
        attemptedEggsCount[targetEgg.Model] = (attemptedEggsCount[targetEgg.Model] or 0) + 1
        if attemptedEggsCount[targetEgg.Model] >= 3 then
            failedEggsCache[targetEgg.Model] = tick()
        end
    else
        attemptedEggsCount[targetEgg.Model] = nil
    end

    -- ALUR PILIHAN DIP WILD EGG
    if Config.DipEggEnabled then
        -- Jika DIP nyala: Langsung tween ke Puncak Gunung -> Dip Egg -> Tunggu 10.5s -> TP ke Depan Base -> Jatuhkan Egg 1s -> Click E 3x -> Tween ke Dalam Base
        scriptStatusState.AutoFarmActivity = string.format("Dip Volcano (%ss)...", tostring(Config.DipWaitTime or 10.5))
        tweenPlayerToCFrame(volcanoPeakCF, mazeSpeed)
        task.wait(0.10)
        triggerVolcanoDipRemote()
        task.wait(Config.DipWaitTime or 10.5)

        scriptStatusState.AutoFarmActivity = "TP ke Depan Base..."
        teleportPlayerToCFrame(getFrontOfBaseCFrame())
        task.wait(0.6)

        scriptStatusState.AutoFarmActivity = "Menjatuhkan Egg (1s)..."
        triggerBasketDropRemote()
        task.wait(1.0)

        scriptStatusState.AutoFarmActivity = "Click E di Depan Base..."
        triggerProximityOnEgg(nil)
        task.wait(0.25)

        scriptStatusState.AutoFarmActivity = "Tween ke Dalam Base..."
        tweenPlayerToCFrame(getInsideBaseCFrame(), mazeSpeed)
        task.wait(0.5)
    else
        -- Jika DIP mati: Langsung TP ke Depan Base -> Jatuhkan Egg 1s -> Click E 2x -> Tween ke Dalam Base
        scriptStatusState.AutoFarmActivity = "TP ke Depan Base..."
        teleportPlayerToCFrame(getFrontOfBaseCFrame())
        task.wait(0.6)

        scriptStatusState.AutoFarmActivity = "Menjatuhkan Egg (1s)..."
        triggerBasketDropRemote()
        task.wait(1.0)

        scriptStatusState.AutoFarmActivity = "Click E di Depan Base..."
        triggerProximityOnEgg(nil)
        task.wait(0.25)

        scriptStatusState.AutoFarmActivity = "Tween ke Dalam Base..."
        tweenPlayerToCFrame(getInsideBaseCFrame(), mazeSpeed)
        task.wait(0.5)
    end

    scriptStatusState.AutoFarmActivity = "Idle / Loop Berikutnya"
    isAutoFarming = false
end

task.spawn(function()
    while task.wait(0.04) and __zAlive() do
        if (Config.AutoFarmEnabled or Config.AutoCatchVolcanicEgg) and not isAutoFarming then
            pcall(runAutoFarmCycle)
            local act = tostring(scriptStatusState.AutoFarmActivity)
            if act:find("Menunggu") or act:find("Tidak Ditemukan") then
                task.wait(0.3)
            end
        else
            if not Config.AutoFarmEnabled and not Config.AutoCatchVolcanicEgg then
                scriptStatusState.AutoFarmActivity = "Auto Farm Off"
                task.wait(0.3)
            end
        end
    end
end)

