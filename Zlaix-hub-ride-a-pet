            detectedEggsList = scannedList
            
            local etherealCount, divineCount, mythicCount = 0, 0, 0
            local legCount, epicCount, rareCount, commonCount = 0, 0, 0, 0
            local volcanicCount = 0
            
            local currentEggKeys = {}

            for _, info in pairs(detectedEggsList) do
                local r = info.Rarity
                local key = info.Name .. "_" .. tostring(info.Position)
                currentEggKeys[key] = true

                -- Trigger Notification if new spawn
                if not knownSpawnedEggs[key] then
                    knownSpawnedEggs[key] = true
                    local dist = (charPos - info.Position).Magnitude
                    if (r == "Volcanic" and Config.NotifyVolcanic) or
                       (r == "Ethereal" and Config.NotifyEthereal) or
                       (r == "Divine" and Config.NotifyDivine) or
                       (r == "Mythic" and Config.NotifyMythic) or
                       (r == "Legendary" and Config.NotifyLegendary) or
                       (r == "Epic" and Config.NotifyEpic) or
                       (r == "Rare" and Config.NotifyRare) then
                        showToastNotification(r, info.Name, dist)
                    end
                end

                if r == "Volcanic" then volcanicCount = volcanicCount + 1
                elseif r == "Ethereal" then etherealCount = etherealCount + 1
                elseif r == "Divine" then divineCount = divineCount + 1
                elseif r == "Mythic" then mythicCount = mythicCount + 1
                elseif r == "Legendary" then legCount = legCount + 1
                elseif r == "Epic" then epicCount = epicCount + 1
                elseif r == "Rare" then rareCount = rareCount + 1
                else commonCount = commonCount + 1 end
            end
            
            for k, _ in pairs(knownSpawnedEggs) do
                if not currentEggKeys[k] then
                    knownSpawnedEggs[k] = nil
                end
            end

            scriptStatusState.MapEtherealCount = etherealCount
            scriptStatusState.MapDivineCount = divineCount
            scriptStatusState.MapMythicCount = mythicCount
            scriptStatusState.MapLegendaryCount = legCount
            scriptStatusState.MapEpicCount = epicCount
            scriptStatusState.MapRareCount = rareCount
            scriptStatusState.MapCommonCount = commonCount
            scriptStatusState.MapVolcanicCount = volcanicCount
            scriptStatusState.TotalMapEggs = #detectedEggsList

            scriptStatusState.PlantedEggsCount = getPlantedEggsCount()
            scriptStatusState.HatchLuckText = getLiveHatchLuckText()

            pcall(function()
                -- Tab Information Labels
                StatusScriptLabel.Set("Script Status: [ ONLINE / ACTIVE ]")
                StatusActivityLabel.Set("Auto Farm Activity: " .. scriptStatusState.AutoFarmActivity)
                StatusLuckLabel.Set("Hatch Luck Terdeteksi: " .. scriptStatusState.HatchLuckText)
                StatusPlantedLabel.Set("Egg Ditanam di Base Plot: " .. tostring(scriptStatusState.PlantedEggsCount))
                StatusEtherealLabel.Set("Ethereal Egg di Map: " .. tostring(scriptStatusState.MapEtherealCount))
                StatusVolcanicLabel.Set("Volcanic Egg di Map: " .. tostring(scriptStatusState.MapVolcanicCount))

                -- Tab Egg Live Tracker Labels
                LiveVolcanicLabel.Set("Volcanic Eggs: " .. tostring(scriptStatusState.MapVolcanicCount))
                LiveEtherealLabel.Set("Ethereal Eggs: " .. tostring(scriptStatusState.MapEtherealCount))
                LiveDivineLabel.Set("Divine Eggs: " .. tostring(scriptStatusState.MapDivineCount))
                LiveMythicLabel.Set("Mythic Eggs: " .. tostring(scriptStatusState.MapMythicCount))
                LiveLegendaryLabel.Set("Legendary Eggs: " .. tostring(scriptStatusState.MapLegendaryCount))
                LiveEpicLabel.Set("Epic Eggs: " .. tostring(scriptStatusState.MapEpicCount))
                LiveRareCommonLabel.Set(string.format("Rare: %d | Common: %d", scriptStatusState.MapRareCount, scriptStatusState.MapCommonCount))
                LiveTotalMapLabel.Set("Total Wild Eggs di Map: " .. tostring(scriptStatusState.TotalMapEggs))
            end)
        end
    end
    
    if now - lastEspUpdate > 0.12 then
        lastEspUpdate = now
        local currentModels = {}
        for _, info in pairs(detectedEggsList) do
            currentModels[info.Model] = true
            local dist = (charPos - info.Position).Magnitude
            pcall(updateESPForEgg, info, dist)
        end

        for model, _ in pairs(activeESP) do
            if not currentModels[model] or not model.Parent then
                removeESP(model)
            end
        end
    end
end)

